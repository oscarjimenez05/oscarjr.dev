---
import Layout from '../layouts/Layout.astro';
---

<Layout title="home | osquijr.dev"
        themeClass="bg-violet-950 text-zinc-100 font-sans">
	<div class="flex flex-col items-center text-center mt-24">
		<h1 class="text-5xl font-bold tracking-tight mb-4">welcome to <span class="text-blue-400">my</span><span class="text-emerald-400">Portfolio</span></h1>
		<p class="text-xl font-medium">computerScience, math, music and film</p>
		<p class="text-lg">by <span class="text-purple-400">oscarJimenez</span></p>
		<br><br>

		<div class="w-full max-w-2xl bg-zinc-950 text-emerald-400 p-6 rounded-xl shadow-2xl text-left font-mono text-sm sm:text-base border border-zinc-800">
			<div class="flex gap-2 mb-4">
				<div class="w-3 h-3 rounded-full bg-purple-400"></div>
				<div class="w-3 h-3 rounded-full bg-blue-400"></div>
				<div class="w-3 h-3 rounded-full bg-emerald-400"></div>
			</div>

			<p>
				<span id="typewriter"></span><span class="animate-pulse">_</span>
			</p>
		</div>
	</div>
	<section class="w-full max-w-4xl mx-auto mt-16 mb-16 px-6">
		<h2 class="text-2xl font-bold mb-4 tracking-tight border-b border-zinc-300 pb-2">mySkills:</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-left font-mono text-sm sm:text-base">
				<thead>
				<tr class="text-zinc-500">
					<th class="py-4 font-normal w-1/3">category</th>
					<th class="py-4 font-normal">experience</th>
				</tr>
				</thead>
				<tbody class="text-zinc-300">
				<tr class="hover:bg-zinc-900/50 transition-colors">
					<td class="py-4 text-emerald-400">> development</td>
					<td class="py-4">Java, Python, C, Spring Boot, Docker, Git, PostgreSQL, MySQL, Ollama, AT&T Assembly, Directus, React.js, Tailwind, Astro, Typescript, Hyper-V</td>
				</tr>

				<tr class="hover:bg-zinc-900/50 transition-colors">
					<td class="py-4 text-blue-400">> knowledge</td>
					<td class="py-4">Large Language Models, Combinatorics, Calculus, Linear Algebra, Networks, Ethnomathematics, LaTeX</td>
				</tr>

				<tr class="hover:bg-zinc-900/50 transition-colors">
					<td class="py-4 text-purple-400">> creation</td>
					<td class="py-4">Premiere Pro, DaVinci Resolve, JUCE VST, Studio One Pro, Cinematography, Lighting</td>
				</tr>
				</tbody>
			</table>
		</div>
	</section>
</Layout>

<script>
	const options = [
		[
			{ text: "#include <stdio.h>", color: "text-emerald-400" },
			{ text: "// initializing camera module...", color: "text-zinc-500" },
			{ text: "printf(\"Initializing camera module...\");", color: "text-emerald-400" },
			{ text: "return 0;", color: "text-emerald-400" }
		],
		[
			{ text: "import film.cinematography.*;", color: "text-blue-400" },
			{ text: "// setting up lighting...", color: "text-zinc-500" },
			{ text: "render.start();", color: "text-blue-400" }
		],
		[
			{ text: "const apology = \"Not the most frontend-oriented person clearly\";", color: "text-blue-400" },
			{ text: "// but I can make things work...", color: "text-zinc-500" },
			{ text: "console.log(apology);", color: "text-blue-400" }
		]
	];

	const codeLines = options[Math.floor(Math.random() * options.length)];

	const container = document.getElementById("typewriter");
	let lineIndex = 0;
	let charIndex = 0;
	let currentSpan: HTMLSpanElement | null = null;

	function typeWriter() {
		if (lineIndex < codeLines.length) {

			if (charIndex === 0) {
				currentSpan = document.createElement("span");
				currentSpan.className = codeLines[lineIndex].color;
				container.appendChild(currentSpan);
			}

			// Type the next character into that specific span
			currentSpan.innerHTML += codeLines[lineIndex].text.charAt(charIndex);
			charIndex++;

			// If we have reached the end of the current line
			if (charIndex >= codeLines[lineIndex].text.length) {
				lineIndex++;
				charIndex = 0;
				container.appendChild(document.createElement("br")); // Inject an actual HTML line break
				setTimeout(typeWriter, 250);
			}
			else{
				setTimeout(typeWriter, 30); // Speed in milliseconds
			}
		}
	}

	setTimeout(typeWriter, 1000);
</script>
