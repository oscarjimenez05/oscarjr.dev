---
import Layout from '../layouts/Layout.astro';
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";

interface Frontmatter {
  title: string;
  description: string;
  badge?: string;
  tags?: string[];
  date?: string;
  priority?: number;
}

const projectFiles = import.meta.glob<{ frontmatter: Frontmatter }>(
  './projects/*.md',
  { eager: true }
);

const projects = Object.entries(projectFiles)
  .map(([filepath, post]) => {
    const slug = filepath.replace(/^\.\/projects\//, '').replace(/\.md$/, '');
    return {
      ...post.frontmatter,
      href: `/projects/${slug}`,
      dateValue: post.frontmatter.date ? new Date(post.frontmatter.date).getTime() : 0,
      priorityValue: post.frontmatter.priority ?? 0,
    };
  })
  .sort((a, b) => {
    // 1. Sort by priority first (highest number first)
    if (b.priorityValue !== a.priorityValue) {
      return b.priorityValue - a.priorityValue;
    }
    // 2. Tie-break: Sort by date (newest first)
    return b.dateValue - a.dateValue;
  });
---

<Layout title="projects | osquijr.dev"
        themeClass="bg-sky-950 text-zinc-100 font-mono">
  <section class="max-w-4xl mx-auto py-16 px-4 space-y-6">
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-100 animate-in fade-in slide-in-from-top-2 duration-500">
      Featured Projects
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((project, index) => (
        <Card
          title={project.title}
          description={project.description}
          badge={project.badge}
          href={project.href}
          delay={String(((index % 4) + 1) * 100) as '100' | '200' | '300' | '500'}
        >
          {project.tags && project.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag, tagIndex) => (
                <Badge variant={tagIndex === 0 ? 'emerald' : 'zinc'}>
                  {tag}
                </Badge>
              ))}
            </div>
          )}
        </Card>
      ))}
    </div>
  </section>
</Layout>