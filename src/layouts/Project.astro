---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title;

interface Props {
    title?: string;
    frontmatter?: {
        title: string;
        [key: string]: any;
    };
}
---

<Layout
    title={`${title.toLowerCase()} | osquijr.dev`}
    themeClass="bg-sky-950 text-slate-100 font-mono selection:bg-purple-400/25 selection:text-purple-200"
>
    <section class="max-w-4xl mx-auto py-16 px-4 space-y-6">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-slate-50">
            {title}
        </h1>

        <article class="prose prose-invert max-w-none font-mono 
        prose-headings:font-semibold 
        prose-h2:text-2xl prose-h2:text-sky-200 prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:text-cyan-400 prose-h3:mt-8 
        prose-p:text-slate-300 prose-p:leading-relaxed prose-p:my-4 
        prose-strong:text-slate-100 prose-strong:font-semibold
        prose-li:text-slate-300 prose-li:marker:text-cyan-400
        prose-hr:border-sky-800/40 prose-hr:my-10
        prose-blockquote:border-l-2 prose-blockquote:border-purple-400/70 prose-blockquote:bg-slate-900/40 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-300 prose-blockquote:not-italic
        prose-a:text-cyan-400 prose-a:decoration-cyan-400/40 prose-a:underline-offset-4 hover:prose-a:text-purple-300 hover:prose-a:decoration-purple-400/60
        prose-th:text-sky-200 prose-th:border-b prose-th:border-sky-800/60 prose-td:border-b prose-td:border-sky-900/40 prose-td:text-slate-300
        [&_:not(pre)>code]:text-emerald-300 [&_:not(pre)>code]:bg-sky-900/50 [&_:not(pre)>code]:border [&_:not(pre)>code]:border-sky-700/50 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-md
        [&_pre]:relative [&_pre]:pt-9 [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-sky-800/60 [&_pre]:bg-slate-950/85 [&_pre]:shadow-xl
        [&_pre>code]:bg-transparent [&_pre>code]:p-0 [&_pre>code]:border-none [&_pre>code]:shadow-none
        [&_pre[data-language]]:before:content-[attr(data-language)] [&_pre[data-language]]:before:absolute [&_pre[data-language]]:before:top-2.5 [&_pre[data-language]]:before:right-3 [&_pre[data-language]]:before:text-[10px] [&_pre[data-language]]:before:font-sans [&_pre[data-language]]:before:uppercase [&_pre[data-language]]:before:tracking-wider [&_pre[data-language]]:before:text-sky-300/75 [&_pre[data-language]]:before:bg-sky-950 [&_pre[data-language]]:before:px-2 [&_pre[data-language]]:before:py-0.5 [&_pre[data-language]]:before:rounded [&_pre[data-language]]:before:border [&_pre[data-language]]:before:border-sky-800/70">
            <slot />
        </article>
    </section>
</Layout>