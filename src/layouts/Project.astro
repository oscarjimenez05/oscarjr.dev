---
import Layout from './Layout.astro';
const { title } = Astro.props;

interface Props {
	title: string;
	}
---

<Layout title={`${title} | osquijr.dev`}
        themeClass="bg-sky-950 text-zinc-100 font-mono ">
        <section class="max-w-4xl mx-auto py-16 px-4 space-y-6">
            <h1 class="text-5xl font-semibold tracking-tight text-zinc-100">{`${title}`}</h1>
            <slot />
        </section>

</Layout>