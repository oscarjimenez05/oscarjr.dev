---
const { title, themeClass } = Astro.props;

interface Props {
	title: string;
	themeClass: string; // This will hold our Tailwind color/font classes
	}
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body class={`min-h-screen transition-colors duration-300 ${themeClass}`}>
		<header class="max-w-4xl mx-auto p-6">
			<nav>
				<ul class="flex flex-row gap-6 font-bold uppercase tracking-widest text-sm">
					<li><a href="/" class="hover:opacity-70 transition-opacity">home</a></li>
					<li><a href="/projects" class="hover:opacity-70 transition-opacity">projects</a></li>
					<li><a href="/art" class="hover:opacity-70 transition-opacity">art</a></li>
					<li><a href="/about" class="hover:opacity-70 transition-opacity">about</a></li>
				</ul>
			</nav>
		</header>
		<main class="max-w-4xl mx-auto p-6">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
