---
interface Props {
  title: string;
  description: string;
  badge?: string;
  href?: string;
  delay?: '100' | '200' | '300' | '500';
}

const { title, description, badge, href, delay = '100' } = Astro.props;
const delayClass = {
  '100': 'delay-100',
  '200': 'delay-200',
  '300': 'delay-300',
  '500': 'delay-500',
}[delay];
---

<a
  href={href}
  class={`group block rounded-xl border border-zinc-800 bg-zinc-900/60 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-zinc-700 hover:shadow-xl hover:shadow-cyan-500/5 animate-in fade-in slide-in-from-bottom-3 duration-500 fill-mode-both ${delayClass}`}
>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-base font-medium text-zinc-100 transition-colors group-hover:text-cyan-400">
      {title}
    </h3>
    {badge && (
      <span class="rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs text-zinc-400">
        {badge}
      </span>
    )}
  </div>
  <p class="text-sm text-zinc-400 leading-relaxed">
    {description}
  </p>
  <slot />
</a>